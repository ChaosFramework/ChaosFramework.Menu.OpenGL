<Root>
    <DefineMacro id="Expander">
        <Arg name="expandedHeaderHeight"/>
        <Arg name="collapsedHeaderHeight"/>
        <Arg name="contentHeight"/>
        <Arg name="headerToContentMargin"/>
        <Arg name="collapseButtonSize"/>
        <Code>
            <DefineMacro id="Header">
                <Code>
                    <Layout.Grid columns="2" Grid.index="0,0" Grid.marginY="0" margin="0">
                        <Column index="0" width="0.15"/>
                        <Column index="1" width="*"/>

                        <Layout.FlowPanel direction="ttb" align="Center" Grid.index="0,0">
                            <Button id="Expander_Expand" size="{collapseButtonSize}"/>
                        </Layout.FlowPanel>
                        <Layout.Box id="Expander_Header" Grid.index="1,0"/>
                    </Layout.Grid>
                </Code>
            </DefineMacro>

            <Expander_Expanded>
                <Frame/>
                <Layout.Grid rows="3">
                    <Row index="0" height="{expandedHeaderHeight}"/>
                    <Row index="1" height="{headerToContentMargin}"/>
                    <Row index="2" height="{contentHeight}"/>

                    <Macro id="Header"/>

                    <Frame Grid.index="0,2"/>
                    <Layout.Box id="Expander_Content" Grid.index="0,2"/>

                </Layout.Grid>
            </Expander_Expanded>

            <Expander_Collapsed>
                <Frame/>
                <Layout.Grid rows="1">
                    <Row index="0" height="{collapsedHeaderHeight}"/>
                    <Macro id="Header"/>
                </Layout.Grid>
            </Expander_Collapsed>
        </Code>
    </DefineMacro>
</Root>
