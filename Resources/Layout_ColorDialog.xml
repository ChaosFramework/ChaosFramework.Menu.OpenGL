<ColorDialog>
    <Layout.Grid columns="1" rows="4" marginX="0.1" clipChildren="false">
        <Row index="0" height="5*"/>
        <Row index="1" height="75*"/>
        <Row index="2" height="25*"/>
        <Row index="3" height="5*"/>

        <Layout.Grid Grid.index="0,1" columns="4" rows="1" Grid.marginY="0" clipChildren="false">
            <Column index="0" width="0.05*"/>
            <Column index="1" width="0.75*"/>

            <Layout.Grid Grid.index="1,0" rows="4" columns="1" margin="0" clipChildren="false" Grid.marginY="0">
                <Row index="0" height="9*"/>
                <Row index="1" height="1.5*"/>
                <Row index="2" height="2*"/>
                <Row index="3" height="1.5*"/>
                <ColorCircle id="colorCircle" Grid.index="0,0"/>
                <ColorImage Grid.index="0,2"/>
            </Layout.Grid>

            <Layout.Grid Grid.index="2,0" columns="2" rows="5" Grid.marginY="0" clipChildren="false">
                <Column index="0" width="0.1*"/>
                <Row index="4" height="0.25*"/>

                <Label Grid.index="0,0" text="H" size="0.05"/>
                <Label Grid.index="0,1" text="S" size="0.05"/>
                <Label Grid.index="0,2" text="V" size="0.05"/>
                <Label Grid.index="0,3" text="A" size="0.05"/>
                <ColorSlider Grid.index="1,0" Grid.marginY="0" id="sldH" pass="H"/>
                <ColorSlider Grid.index="1,1" Grid.marginY="0" id="sldS" pass="S"/>
                <ColorSlider Grid.index="1,2" Grid.marginY="0" id="sldV" pass="V"/>
                <ColorSlider Grid.index="1,3" Grid.marginY="0" id="sldA" pass="A"/>
            </Layout.Grid>

            <Layout.Grid Grid.index="3,0" columns="2" rows="5" Grid.marginY="0" clipChildren="false">
                <Column index="0" width="0.1*"/>
                <Row index="4" height="0.25*"/>

                <Label Grid.index="0,0" text="R" size="0.05"/>
                <Label Grid.index="0,1" text="G" size="0.05"/>
                <Label Grid.index="0,2" text="B" size="0.05"/>
                <Label Grid.index="0,3" text="#" size="0.05"/>
                <ColorSlider Grid.index="1,0" Grid.marginY="0" id="sldR" pass="R"/>
                <ColorSlider Grid.index="1,1" Grid.marginY="0" id="sldG" pass="G"/>
                <ColorSlider Grid.index="1,2" Grid.marginY="0" id="sldB" pass="B"/>
                <Layout.Grid Grid.index="1,3" Grid.marginY="0" margin="0" rows="3" columns="3" clipChildren="false">
                    <Row index="0" height="10*"/>
                    <Row index="1" height="80*"/>
                    <Row index="2" height="10*"/>
                    <Column index="0" width="5*"/>
                    <Column index="1" width="90*"/>
                    <Column index="2" width="5*"/>
                    <RichTextBox id="txtHex" maxLength="8" textAlign="Center" Grid.index="1,1"/>
                </Layout.Grid>
            </Layout.Grid>
        </Layout.Grid>

        <Layout.Grid Grid.index="0,2" rows="3" columns="3" clipChildren="false">
            <Row index="0" height="05*"/>
            <Row index="1" height="90*"/>
            <Row index="2" height="05*"/>
            <Column index="0" width="15*"/>
            <Column index="1" width="70*"/>
            <Column index="2" width="15*"/>
            <ColorButton id="btnOk" Grid.index="1,1" text="OK" Grid.marginX="0.2"/>
        </Layout.Grid>
    </Layout.Grid>
</ColorDialog>
